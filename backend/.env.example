# Liganx backend env. Copy to .env for local dev, or set as Fly.io secrets in
# production via `fly secrets set KEY=value`. NEVER commit a real .env.

# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
LOG_LEVEL=info                    # debug | info | warning | error
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (Supabase Postgres in prod, SQLite if blank) ──────────────
# Use the Session pooler endpoint (port 5432, IPv4-friendly).
DATABASE_URL=

# ── Pod-hosted GPU docking ─────────────────────────────────────────────
# When set, all docking dispatches to the always-warm RunPod Pod running
# QuickVina2-GPU. Format: https://<pod-id>-<port>.proxy.runpod.net
POD_DOCK_URL=https://4cli33cxvf58lb-7861.proxy.runpod.net
POD_DOCK_TIMEOUT_S=60

# ── Cloudflare R2 (pose storage) ───────────────────────────────────────
# Set ALL FOUR to enable R2; leave any blank to fall back to local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=liganx-poses
# Optional public/CDN URL prefix (e.g. https://poses.liganx.com). When unset,
# pose GETs are proxied through the backend.
R2_PUBLIC_URL=

# ── Pipeline binaries ──────────────────────────────────────────────────
# Local dev: absolute path to vina + foldx in your home dir.
# Production (Docker): leave blank — set inside the image's PATH.
VINA_PATH=vina
FOLDX_PATH=

# ── Pose cache override ────────────────────────────────────────────────
# Where local-disk pose files live when R2 isn't configured. Defaults to
# ~/.deltadock/poses for dev, /var/lib/liganx/poses inside the Fly container.
POSE_CACHE_DIR=
