# DeltaDock environment template
# Copy to .env and fill in values. Never commit .env.

# ─── App ─────────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_SECRET=change-me          # used for sessions / token signing
LOG_LEVEL=info

# ─── Frontend ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────────────────────
# Phase 1 (dev): leave blank to use SQLite at backend/dev.db
# Phase 2: paste a Neon connection string
DATABASE_URL=

# ─── Redis / Celery ──────────────────────────────────────────────────────
# Phase 1: leave blank, jobs run in-process
# Phase 2: Upstash Redis URL
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─── Object storage (Cloudflare R2, S3-compatible) ───────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deltadock-dev
R2_PUBLIC_URL=

# ─── Compute (RunPod) ────────────────────────────────────────────────────
RUNPOD_API_KEY=
RUNPOD_TEMPLATE_ID=

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=hello@deltadock.bio

# ─── Billing (Stripe) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ─── Pipeline tools ──────────────────────────────────────────────────────
# Path to the AutoDock Vina binary on the worker (Phase 1 default: bundled)
VINA_PATH=vina
# FoldX is added in Phase 3
FOLDX_PATH=
