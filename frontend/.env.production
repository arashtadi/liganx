# Production env for the Vite build (used when Vercel runs `npm run build`).
# api.ts reads VITE_API_URL — when set, all requests go to that origin instead
# of the dev `/api` proxy. Empty in dev so the proxy still works.
VITE_API_URL=https://api.liganx.com

# Supabase Auth — public client credentials. The publishable key is safe to
# expose in the browser bundle; Row-Level Security policies on the database
# are what actually enforce who can read/write what data. The new sb_publishable_*
# format is the modern (post-2025) replacement for the legacy eyJ... anon JWT.
VITE_SUPABASE_URL=https://szvvxaknmmterxliqjfz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_4QXSBsr4h50akXddC8ADuQ_ZoIjtb6K
